# Copy to .env for local development. On Render, set these as Environment
# Variables on the service instead (Dashboard -> your service -> Environment).

# Required. MongoDB Atlas connection string, including the database name:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/airline?retryWrites=true&w=majority
# If the password contains @ : / ? # [ ] or %, it must be percent-encoded.
# Without this, every database-backed route returns 503 DB_UNAVAILABLE.
MONGODB_STRING=

# Required in production. Secret used to sign JWTs. Falls back to an insecure
# development default when unset, which would let anyone forge a token.
JWT_SECRET_KEY=

# Optional. Render sets PORT automatically and the app must use it.
# Defaults to 4000 locally, which is what client/src/api.js expects.
PORT=4000
